---
import Default from "@astrojs/starlight/components/Head.astro";
import { variantForPath } from "../data/variants";
import { DEFAULT_SCHEME, schemeById } from "../scripts/theme";

const variant = variantForPath(Astro.url.pathname, import.meta.env.BASE_URL);
const scheme = variant ? schemeById(variant.defaultScheme) : undefined;
const themeColor = scheme?.palette.base00 ?? DEFAULT_SCHEME.palette.base00;

const palette = scheme
  ? Object.entries(scheme.palette)
      .map(([key, value]) => `--${key.toLowerCase()}: ${value};`)
      .join(" ")
  : "";

const light = scheme?.variant === "light";
const lightMapping = `--ojuny-on-accent: var(--base00);
--ojuny-strong: var(--base05);
--ojuny-heading: var(--base05);
--ojuny-text-muted: color-mix(in srgb, var(--base05) 90%, var(--base00));
--ojuny-text-subtle: color-mix(in srgb, var(--base05) 82%, var(--base00));
--sl-color-white: var(--base05);
--sl-color-gray-1: var(--base05);
--sl-color-gray-2: var(--base05);
--sl-color-gray-3: color-mix(in srgb, var(--base05) 82%, var(--base00));
--sl-color-gray-4: color-mix(in srgb, var(--base05) 55%, var(--base00));
--sl-color-gray-5: var(--base02);
--sl-color-gray-6: var(--base01);
--sl-color-gray-7: var(--base00);
--sl-color-black: var(--base00);
color-scheme: light;`;
---

<Default />
<meta name="theme-color" content={themeColor} />

{
  scheme && (
    <style
      is:inline
      set:html={`:root:root:root { ${palette} ${light ? lightMapping : ""} }`}
    />
  )
}
