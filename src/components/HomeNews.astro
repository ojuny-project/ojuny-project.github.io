---
import HomeSection from "./HomeSection.astro";
import SectionHeading from "./SectionHeading.astro";

const base = import.meta.env.BASE_URL;
const items = [
  {
    title: "Six product templates",
    excerpt: "Pro, Console, Fleet, Minimal, Home Server, and Infrastructure share one template contract.",
    href: `${base}doctrine/`,
  },
  {
    title: "A ghost distribution",
    excerpt: "No paid infrastructure, no permanent maintainer, and no privileged official repository.",
    href: `${base}doctrine/`,
  },
  {
    title: "No release yet",
    excerpt: "No ISO release and no release schedule. The repositories are usable from source.",
    href: `${base}status/`,
  },
  {
    title: "Support is GitHub issues only",
    excerpt: "No support team, no paid support, and no warranty.",
    href: "https://github.com/ojuny-project",
  },
];
---

<HomeSection id="news">
  <SectionHeading
    eyebrow="Status"
    title="Where the project stands"
    action={{ label: "Read the status page", href: `${base}status/` }}
  />

  <ul class="ojuny-news-list">
    {
      items.map((item) => (
        <li data-reveal>
          <a href={item.href}>
            <span class="ojuny-news-title">{item.title}</span>
            <span class="ojuny-news-excerpt">{item.excerpt}</span>
          </a>
        </li>
      ))
    }
  </ul>
</HomeSection>
