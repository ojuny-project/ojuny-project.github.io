---
const base = import.meta.env.BASE_URL;
---

<figure class="ojuny-shot">
  <img
    src={`${base}ojuny-wallpaper.png`}
    alt="The Ojuny desktop wallpaper, an Everforest landscape"
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    Everforest Dark Hard, the default palette for Ojuny and for this site.
  </figcaption>
</figure>
