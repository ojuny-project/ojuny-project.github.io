---
import { variantBySlug } from "../../data/variants";
import { schemeById } from "../../scripts/theme";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const variant = variantBySlug(slug);

if (!variant) throw new Error(`Unknown Ojuny variant: ${slug}`);

const scheme = schemeById(variant.defaultScheme);
const base = import.meta.env.BASE_URL;
const swatches = scheme
  ? ["base08", "base0a", "base0b", "base0c", "base0d", "base0e"].map(
      (key) => scheme.palette[key],
    )
  : [];
---

<section
  class="ojuny-variant-hero ojuny-hero-home"
  aria-labelledby={`ojuny-variant-${slug}-title`}
>
  <div class="home-appliance">
    <div class="home-top">
      <span class="home-led" aria-hidden="true"></span>
      <span>Always on</span>
      <span class="home-version">Headless NAS and server</span>
    </div>

    <div class="home-copy">
      <h1 id={`ojuny-variant-${slug}-title`}>{variant.name}</h1>

      <p class="home-tagline">{variant.tagline}</p>
      <p class="home-lead">{variant.description}</p>

      <div class="home-actions">
        <a class="home-button" href={`${base}${slug}/docs/overview/`}>
          Read the documentation
        </a>
        <a class="home-link" href={base}>Ojuny</a>
      </div>
    </div>

    <ul class="home-strip" aria-label="Home Server facts">
      {variant.facts.map((fact) => <li>{fact}</li>)}
    </ul>

    <footer class="home-foot">
      <div class="home-scheme">
        <span>Default scheme</span>
        <strong>{scheme?.name ?? variant.defaultScheme}</strong>
        <span class="ojuny-scheme-swatches" aria-hidden="true">
          {swatches.map((color) => <span style={`--swatch: ${color}`}></span>)}
        </span>
      </div>
    </footer>
  </div>
</section>
