---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import { VARIANTS, variantForPath } from "../data/variants";

const { sidebar } = Astro.locals.starlightRoute;
const variant = variantForPath(Astro.url.pathname, import.meta.env.BASE_URL);
const variantNames = new Set(VARIANTS.map((entry) => entry.name));

const variantsGroup = sidebar.find(
  (entry) => entry.type === "group" && entry.label === "Variants",
);

const ownGroup = variant
  ? sidebar.find((entry) => entry.type === "group" && entry.label === variant.name)
  : undefined;

const entries = variant
  ? ownGroup
    ? [ownGroup, ...(variantsGroup ? [variantsGroup] : [])]
    : sidebar
  : sidebar.filter(
      (entry) => !(entry.type === "group" && variantNames.has(entry.label)),
    );
---

<SidebarPersister>
  <SidebarSublist sublist={entries} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
