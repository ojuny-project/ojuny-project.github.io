---
import HomeSection from "./HomeSection.astro";
import SectionHeading from "./SectionHeading.astro";

const figures = [
  { value: "360", label: "base16 themes" },
  { value: "6", label: "product templates" },
  { value: "1", label: "template contract" },
  { value: "0", label: "paid infrastructure" },
  { value: "0", label: "single-maintainer dependency" },
];
---

<HomeSection id="figures" alt>
  <SectionHeading
    eyebrow="Figures"
    title="The shape of the project"
    description="Not a growth chart. The properties that keep Ojuny forkable."
  />

  <div class="ojuny-figures">
    {
      figures.map((figure) => (
        <div class="ojuny-figure" data-reveal>
          <span class="ojuny-figure-value">{figure.value}</span>
          <span class="ojuny-figure-label">{figure.label}</span>
        </div>
      ))
    }
  </div>
</HomeSection>
