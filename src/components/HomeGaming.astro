---
import HomeCardsSection from "./HomeCardsSection.astro";

const base = import.meta.env.BASE_URL;
---

<HomeCardsSection
  id="gaming"
  eyebrow="Gaming"
  title="A console product, or a gaming desktop"
  description="The base desktop keeps gaming optional. Ojuny Console is a separate product template that boots into Steam Big Picture under gamescope. The desktop can still add a Gamescope session with a patch."
  action={{ label: "Console product", href: `${base}console/` }}
  columns={2}
  items={[
    {
      eyebrow: "Base desktop",
      title: "Lean by default",
      body: "Steam, Proton GE, GameMode, and compatibility tools are one toggle away on the base desktop.",
    },
    {
      eyebrow: "Console",
      title: "A separate product",
      body: "Console is its own template and installer. It starts in Steam Big Picture with a controller-first settings frontend.",
    },
    {
      eyebrow: "Contract",
      title: "Same template shape",
      body: "Console follows the same template contract as the base desktop, with its own session layer and install media.",
    },
    {
      eyebrow: "Gaps",
      title: "Patches fill them",
      body: "Wine, winetricks, protontricks, and gamescope are installable without a terminal ritual.",
    },
  ]}
/>
