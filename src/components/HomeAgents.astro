---
import HomeSection from "./HomeSection.astro";
import SectionHeading from "./SectionHeading.astro";
import HomeCards from "./HomeCards.astro";

const base = import.meta.env.BASE_URL;

const items = [
  {
    eyebrow: "Default",
    title: "AI-free out of the box",
    body: "The default install ships no model server, no agent, no chat UI, and no telemetry. It is fully AI-free out of the box.",
  },
  {
    eyebrow: "Maintenance",
    title: "ojuny-agent",
    body: "The maintenance agent edits inside the flake only with explicit approval. It validates every change, shows the diff, can revert, and can sync the flake git.",
  },
  {
    eyebrow: "Explain",
    title: "ojuny-assist",
    body: "The read-only explainer answers questions about Ojuny, the settings menu, patches, and the flake. It cannot edit, sync, revert, rebuild, or mutate anything.",
  },
  {
    eyebrow: "Interface",
    title: "ojuny-agent-cli",
    body: "The flake-safe CLI is read-only by default. Mutating commands require --yes, never accept --flake, and never push.",
  },
  {
    eyebrow: "Local model",
    title: "patch-local-llm",
    body: "Adds the local model server, the Nix-managed harness, and the LSP wiring for a fully local agent stack.",
  },
  {
    eyebrow: "Safety",
    title: "Designed for agents",
    body: "The flake is the boundary. Agents work in a Git diff and validate before the user rebuilds. They never get sudo, rebuild, package, or service control.",
  },
];
---

<HomeSection id="agents">
  <SectionHeading
    eyebrow="Agentic use"
    title="AI-free out of the box. Agentic on request."
    description="Ojuny is built to be agent-ready without shipping an agent. The optional patch adds a full agentic workflow that works inside the flake instead of handing an agent the machine."
    action={{ label: "Read the agent docs", href: `${base}configuration/agentic/` }}
  />

  <HomeCards items={items} columns={3} />

  <div class="ojuny-agent-install" data-reveal>
    <div>
      <p class="ojuny-eyebrow">Install the agent patch</p>
      <h3>One patch, then the normal rebuild.</h3>
      <p>
        The patch does not enable itself. Install it, turn on Development and
        Ojuny agent in Patches, then rebuild. The agent works on the flake, not
        on the running system.
      </p>
    </div>

    <pre><code>ojuny-patches sync
ojuny-patches install patch-ojuny-agent</code></pre>
  </div>

  <p class="ojuny-agent-note" data-reveal>
    The default install is fully AI-free out of the box. Ojuny uses AI as a
    tool in its own development and does not claim to be 100 percent AI-free.
  </p>
</HomeSection>
