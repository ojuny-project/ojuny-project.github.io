---
import logo from "../assets/ojuny-logo.png";
import BrandImage from "./BrandImage.astro";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a
  href={siteTitleHref}
  class="site-title ojuny-site-title"
  aria-label={siteTitle}
  title={siteTitle}
>
  <BrandImage
    src={logo.src}
    width={96}
    height={96}
    alt=""
    loading="eager"
    class="ojuny-logo-shell"
  />
</a>

<script>
  const BRAND_FILLS = [
    [79, 91, 88],
    [230, 126, 128],
    [127, 187, 179],
    [219, 188, 127],
  ];

  interface BrandSource {
    width: number;
    height: number;
    indices: Uint8Array;
    alphas: Uint8Array;
  }

  const sourceCache = new Map<string, Promise<BrandSource>>();

  function parseColor(value: string): [number, number, number] {
    const hex = value.replace("#", "");
    return [
      Number.parseInt(hex.slice(0, 2), 16),
      Number.parseInt(hex.slice(2, 4), 16),
      Number.parseInt(hex.slice(4, 6), 16),
    ];
  }

  function brandSlots(): string[] {
    const strong = document.documentElement.dataset.theme === "light" ? "base05" : "base03";
    return [strong, "base08", "base0d", "base0a"];
  }

  function closestFill(red: number, green: number, blue: number): number {
    let best = 0;
    let bestDistance = Number.POSITIVE_INFINITY;

    for (let index = 0; index < BRAND_FILLS.length; index += 1) {
      const fill = BRAND_FILLS[index];
      const distance =
        (red - fill[0]) ** 2 + (green - fill[1]) ** 2 + (blue - fill[2]) ** 2;
      if (distance < bestDistance) {
        bestDistance = distance;
        best = index;
      }
    }

    return best;
  }

  function prepare(canvas: HTMLCanvasElement): Promise<BrandSource> {
    const src = canvas.dataset.brandSrc;
    if (!src) return Promise.reject(new Error("Brand source is missing"));

    const key = `${src}:${canvas.width}x${canvas.height}`;
    const cached = sourceCache.get(key);
    if (cached) return cached;

    const prepared = (async () => {
      const image = new Image();
      image.src = src;
      await image.decode();

      const offscreen = document.createElement("canvas");
      offscreen.width = canvas.width;
      offscreen.height = canvas.height;
      const context = offscreen.getContext("2d");
      if (!context) throw new Error("Could not prepare brand canvas");

      context.drawImage(image, 0, 0, canvas.width, canvas.height);
      const data = context.getImageData(0, 0, canvas.width, canvas.height);
      const indices = new Uint8Array(canvas.width * canvas.height);
      const alphas = new Uint8Array(canvas.width * canvas.height);
      const lookup = new Map<number, number>();

      for (let pixel = 0, index = 0; pixel < data.data.length; pixel += 4, index += 1) {
        const red = data.data[pixel];
        const green = data.data[pixel + 1];
        const blue = data.data[pixel + 2];
        const alpha = data.data[pixel + 3];
        alphas[index] = alpha;
        if (alpha === 0) continue;

        const colorKey = (red << 16) | (green << 8) | blue;
        let fill = lookup.get(colorKey);
        if (fill === undefined) {
          fill = closestFill(red, green, blue);
          lookup.set(colorKey, fill);
        }
        indices[index] = fill;
      }

      return { width: canvas.width, height: canvas.height, indices, alphas };
    })();

    sourceCache.set(key, prepared);
    return prepared;
  }

  function render(canvas: HTMLCanvasElement, source: BrandSource): void {
    const context = canvas.getContext("2d");
    if (!context) return;

    const styles = getComputedStyle(document.documentElement);
    const targets = brandSlots().map((slot) =>
      parseColor(styles.getPropertyValue(`--${slot}`).trim() || "#000000"),
    );
    const output = context.createImageData(source.width, source.height);

    for (let pixel = 0, index = 0; index < source.indices.length; pixel += 4, index += 1) {
      const target = targets[source.indices[index]];
      output.data[pixel] = target[0];
      output.data[pixel + 1] = target[1];
      output.data[pixel + 2] = target[2];
      output.data[pixel + 3] = source.alphas[index];
    }

    context.putImageData(output, 0, 0);
    canvas.closest(".ojuny-brand-shell")?.classList.add("is-recolored");
  }

  async function renderAll(): Promise<void> {
    const canvases = Array.from(
      document.querySelectorAll<HTMLCanvasElement>("[data-brand-canvas]"),
    );

    await Promise.all(
      canvases.map(async (canvas) => {
        const source = await prepare(canvas);
        render(canvas, source);
      }),
    );
  }

  void renderAll().catch(() => {});
  window.addEventListener("ojuny:theme-change", () => {
    void renderAll().catch(() => {});
  });
</script>
