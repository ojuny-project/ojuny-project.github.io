<canvas class="ojuny-home-hexagons" data-hexagons aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-hexagons]");
  const context = canvas?.getContext("2d");

  if (canvas && context) {
    const ctx: CanvasRenderingContext2D = context;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const radius = 44;
    const hexHeight = Math.sqrt(3) * radius;
    const hexStep = radius * 1.5;

    let width = 0;
    let height = 0;
    let frame = 0;
    let running = false;
    let pointerX = 0;
    let pointerY = 0;
    let smoothX = 0;
    let smoothY = 0;
    let accent = "#7fbbb3";
    let accentTwo = "#d699b6";

    const readColors = () => {
      const styles = getComputedStyle(document.documentElement);
      accent = styles.getPropertyValue("--base0d").trim() || "#7fbbb3";
      accentTwo = styles.getPropertyValue("--base0e").trim() || "#d699b6";
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.max(1, Math.round(width * ratio));
      canvas.height = Math.max(1, Math.round(height * ratio));
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      if (reduced) draw(0);
    };

    const hexPath = (x: number, y: number, size: number) => {
      ctx.beginPath();
      for (let side = 0; side < 6; side += 1) {
        const angle = (Math.PI / 3) * side;
        const px = x + size * Math.cos(angle);
        const py = y + size * Math.sin(angle);
        if (side === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, width, height);
      smoothX += (pointerX - smoothX) * 0.04;
      smoothY += (pointerY - smoothY) * 0.04;

      const driftX = smoothX * 26;
      const driftY = smoothY * 26;
      const columns = Math.ceil(width / hexStep) + 2;
      const rows = Math.ceil(height / hexHeight) + 2;

      for (let column = -1; column < columns; column += 1) {
        for (let row = -1; row < rows; row += 1) {
          const x = column * hexStep + driftX;
          const y =
            row * hexHeight +
            (column % 2 === 0 ? 0 : hexHeight / 2) +
            driftY;
          const wave = Math.sin(time * 0.0007 + x * 0.012 + y * 0.009);
          const pulse = (wave + 1) / 2;
          const alpha = 0.035 + pulse * 0.11;

          ctx.globalAlpha = alpha;
          ctx.strokeStyle = accent;
          ctx.lineWidth = 1;
          hexPath(x, y, radius - 2);
          ctx.stroke();

          if (pulse > 0.82) {
            ctx.globalAlpha = (pulse - 0.82) * 0.55;
            ctx.fillStyle = accentTwo;
            hexPath(x, y, (radius - 2) * 0.64);
            ctx.fill();
          }

          if (pulse > 0.94) {
            ctx.globalAlpha = 0.45;
            ctx.fillStyle = accent;
            ctx.beginPath();
            ctx.arc(x, y, 1.6, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }

      ctx.globalAlpha = 1;
    };

    const tick = (time: number) => {
      if (!running) return;
      draw(time);
      frame = window.requestAnimationFrame(tick);
    };

    const start = () => {
      if (running || reduced) return;
      running = true;
      frame = window.requestAnimationFrame(tick);
    };

    const stop = () => {
      running = false;
      window.cancelAnimationFrame(frame);
    };

    window.addEventListener("pointermove", (event) => {
      pointerX = event.clientX / window.innerWidth - 0.5;
      pointerY = event.clientY / window.innerHeight - 0.5;
    });

    window.addEventListener("ojuny:theme-change", () => {
      readColors();
      if (reduced) draw(0);
    });

    const observer = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { rootMargin: "120px" },
    );

    readColors();
    resize();
    observer.observe(canvas);
    window.addEventListener("resize", resize);

    if (reduced) draw(0);
  }
</script>
